{
	quest.17C76F6A7253102A.quest_desc: ["Büyücüler için özel zırh setleri var: ateş büyüleri için &ePyromancer&r, buz için &eCryomancer&r, yıldırım için &eElectromancer&r, kutsal büyüler için &ePriest&r ve diğerleri. Her set kendi okulunun büyülerini güçlendirir ve maksimum manayı artırır. Zırhlar büyülü kumaş (Magic Cloth) ve okulun özüyle yapılır, JEI'de 'armor' diye arayarak hepsini görebilirsin. Hangi büyü okulunu sevdiysen ona göre seç."]
	quest.17C76F6A7253102A.title: "Büyücü Zırhları"
	quest.1B632047F9F5E16D.quest_desc: ["&eAlchemist Cauldron&r ateş üstüne konan büyülü bir kazan. İçine su koyup istenmeyen parşömenleri atarsan onları &emürekkebe&r (ink) çevirir. Mürekkeplerle &eScroll Forge&r'da kendi parşömenlerini yazabilirsin. Kazan ayrıca özel iksirlerin yapımında da kullanılır."]
	quest.2BAF1C42641595D2.quest_desc: ["&eUpgrade Orb&r, Arcane Ingot, Cinder Essence ve Mithril ile yapılır. Boş orb'u bir okulun rünüyle (örneğin ateş) birleştirip o okulu güçlendiren orb'lar yaparsın; &eMana Upgrade Orb&r ise maksimum manayı artırır. Bunları Arcane Anvil'de zırhlarına tak. Mithril derinlerde, deepslate katmanında bulunan nadir bir cevher."]
	quest.2BAF1C42641595D2.title: "Upgrade Orb"
	quest.402B7907B5BBCF11.quest_desc: ["&eCopper Spell Book&r'u bakır, kağıt ve iple yap. Büyü kitabını Curios yuvasına (envanterdeki ekstra yuvalar) ya da eline al. Sonra &eInscription Table&r'da kitabı ve bir parşömeni birleştirerek büyüyü kitaba kalıcı olarak yaz. Büyü kullanmak için büyü çarkını açıp (tuşunu Ayarlar > Kontroller > Tuşlar'da 'Iron's Spellbooks' altında görebilirsin) büyüyü seçer ve tuşa basarsın. Büyüler mana harcar; ekranın altındaki mavi çubuk manan."]
	quest.402B7907B5BBCF11.title: "İlk Büyü Kitabı"
	quest.67350A58F8B0015C.quest_desc: ["&eArcane Anvil&r ile iki şey yapabilirsin: aynı büyünün iki parşömenini birleştirip &ebir seviye yukarı&r çıkarmak, ve silahlara ya da zırhlara &eUpgrade Orb&r takarak onlara büyü gücü kazandırmak. Böylece normal bir kılıca bile büyü yuvası ekleyebilirsin."]
	quest.681A2FBB806F725F.quest_desc: ["&eIron's Spells 'n Spellbooks&r'ta büyüler &eparşömenlerde&r (scroll) bulunur: ateş topu, ışınlanma, iyileştirme, yıldırım ve onlarcası. Parşömenleri zindanlardan, büyücü düşmanlardan ve köylülerden elde edersin. Modun ana malzemesi &eArcane Essence&r; büyü kullanan düşmanlardan düşer ve sandıklarda bulunur. JEI'de üzerine gelip &eR&r'ye basarak başka nereden çıktığına bakabilirsin."]
	quest.6F63267C0CD4062A.quest_desc: ["Büyü kitaplarının seviyeleri var: Copper → Iron → Gold → Diamond ve ötesi. Yüksek seviye kitaplar daha fazla büyü yuvası taşır ve bazıları ekstra mana ya da büyü gücü verir. Boss'lardan düşen özel kitaplar (örneğin ölümsüz kralın kitabı) en güçlüleri."]
	quest.6F63267C0CD4062A.title: "Daha Büyük Kitaplar"
}
